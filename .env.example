# Copy to .env.local and fill in. Never commit .env.local.

# --- Claude ---
# Create a key at https://platform.claude.com/ (or run `ant auth login` and leave this unset).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# --- PayPal ---
# Create a REST app at https://developer.paypal.com/dashboard/applications
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook you create for https://YOUR-DOMAIN/api/paypal/webhook (differs per environment).
# Without it the webhook route refuses every event.
PAYPAL_WEBHOOK_ID=
# Optional. The merchant email shown on invoices.
# PAYPAL_INVOICER_EMAIL=

# --- Product ---
# Public URL, used in the link inside invoice emails. No trailing slash.
APP_URL=http://localhost:3000
# Dispute kit price in USD.
KIT_PRICE_USD=9.00

# --- Storage ---
# Where submitted messages and payment records are kept.
# Must be on a persistent, writable disk (see "Deploying" in the README).
# STORE_FILE=.data/store.json
