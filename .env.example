# Copy to .env.local and fill in. Never commit .env.local.

# --- AI ---
# Which AI checks messages: claude (default) or gemini (free tier available).
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash, falling back to gemini-3.5-flash-lite when busy.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Hackathon demo with no AI at all: pattern rules, clearly labelled. Never for real users.
# DEMO_MODE=true

# --- Claude ---
# Create a key at https://platform.claude.com/ (or run `ant auth login` and leave this unset).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# --- PayPal ---
# Create a REST app at https://developer.paypal.com/dashboard/applications
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook you create for https://YOUR-DOMAIN/api/paypal/webhook (differs per environment).
# Without it the webhook route refuses every event.
PAYPAL_WEBHOOK_ID=
# Optional. The merchant email shown on invoices.
# PAYPAL_INVOICER_EMAIL=

# --- Product ---
# Public URL, used in the link inside invoice emails. No trailing slash.
APP_URL=http://localhost:3000
# Dispute kit price in USD.
KIT_PRICE_USD=9.00

# --- Storage ---
# Where submitted messages and payment records are kept.
# Must be on a persistent, writable disk (see "Deploying" in the README).
# STORE_FILE=.data/store.json
